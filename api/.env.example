# Copier ce fichier en .env puis adapter les valeurs. Le fichier .env ne doit pas être versionné.

# SQLite en local. En production : l'URL PostgreSQL fournie par l'hébergeur.
DATABASE_URL=sqlite:///./mes_depenses.db

# Au moins 32 caractères. Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Origines autorisées pour le site web, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173

# Modèle de catégorisation. Tant que le fichier n'existe pas, l'API utilise des règles par mots-clés.
MODEL_PATH=models/categorizer.joblib

# Assistant IA. Clé gratuite à créer sur https://console.groq.com. Sans clé, l'assistant est désactivé
# et le reste de l'application fonctionne normalement.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
